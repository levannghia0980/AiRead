# AIREAD Environment Configuration Example
# Sao chép file này thành .env và điền thông số thích hợp

# AI Provider: gemini | openai | custom
AIREAD_PROVIDER=gemini

# Model Name
AIREAD_MODEL=gemini-2.0-flash

# API Key (Phân cách bằng dấu phẩy nếu dùng nhiều key load balancing)
AIREAD_API_KEYS=your_api_key_here

# Số lượng luồng xử lý đồng thời (Concurrency)
AIREAD_CONCURRENCY=15

# Đô trễ giữa các request (giây)
AIREAD_DELAY=5.0

# Batch size dịch thuật
AIREAD_BATCH_SIZE=2

# Phong cách dịch thuật: draft_only | polished | natural
AIREAD_TRANSLATION_STYLE=draft_only

# Prompt tùy chỉnh (để trống nếu dùng mặc định)
AIREAD_CUSTOM_PROMPT=
